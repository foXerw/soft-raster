# twomats.obj — M5.4 手写资产（两个盒子、三个材质组）。
# 盒 A 全用 plain（Kd 红、无贴图）；盒 B 前三面 texA、后三面 texB，
# 两者 map_Kd 都指 ../tga/checker.tga ⇒ canonical 去重后 textures.size()==1。
# 绕向沿用 makeCube 的约定：从外面看逆时针（D10）。面序 +X,-X,+Y,-Y,+Z,-Z。
mtllib twomats.mtl
v -1.7 -0.5 -0.5
v -0.7 -0.5 -0.5
v -0.7 0.5 -0.5
v -1.7 0.5 -0.5
v -1.7 -0.5 0.5
v -0.7 -0.5 0.5
v -0.7 0.5 0.5
v -1.7 0.5 0.5
v 0.7 -0.5 -0.5
v 1.7 -0.5 -0.5
v 1.7 0.5 -0.5
v 0.7 0.5 -0.5
v 0.7 -0.5 0.5
v 1.7 -0.5 0.5
v 1.7 0.5 0.5
v 0.7 0.5 0.5
vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 -1 0
vn 0 0 1
vn 0 0 -1
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
usemtl plain
f 2//1 3//1 7//1 6//1
f 5//2 8//2 4//2 1//2
f 4//3 8//3 7//3 3//3
f 1//4 2//4 6//4 5//4
f 5//5 6//5 7//5 8//5
f 2//6 1//6 4//6 3//6
usemtl texA
f 10/1/1 11/2/1 15/3/1 14/4/1
usemtl texA
f 13/5/2 16/6/2 12/7/2 9/8/2
usemtl texA
f 12/9/3 16/10/3 15/11/3 11/12/3
usemtl texB
f 9/13/4 10/14/4 14/15/4 13/16/4
usemtl texB
f 13/17/5 14/18/5 15/19/5 16/20/5
usemtl texB
f 10/21/6 9/22/6 12/23/6 11/24/6
